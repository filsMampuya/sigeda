NODE_ENV=development
PORT=4100
DATABASE_URL=postgresql://sigeda:sigeda@localhost:5432/sigeda

KEYCLOAK_ISSUER=http://localhost:8080/realms/sigeda
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/sigeda/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=sigeda-web
KEYCLOAK_REALM=sigeda
KEYCLOAK_ADMIN_BASE_URL=http://localhost:8080
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=sigeda-documents
MINIO_ACCESS_KEY=sigeda
MINIO_SECRET_KEY=sigeda-password

OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_INDEX_DOCUMENTS=documents

DOCUMENT_AI_MODE=ocr
DOCUMENT_AI_TIMEOUT_MS=180000
DOCUMENT_AI_OLLAMA_KEEP_ALIVE=15m
DOCUMENT_AI_OLLAMA_TEMPERATURE=0
DOCUMENT_AI_OLLAMA_NUM_PREDICT=160
DOCUMENT_AI_MAX_OCR_TEXT_CHARS=4000
DOCUMENT_AI_VISION_BASE_URL=http://localhost:11434
DOCUMENT_AI_VISION_MODEL=moondream
DOCUMENT_AI_TEXT_BASE_URL=http://localhost:11434
DOCUMENT_AI_TEXT_MODEL=qwen2.5:0.5b
DOCUMENT_AI_LOW_CONFIDENCE_THRESHOLD=0.70
DOCUMENT_AI_DEBUG=false
DOCUMENT_AI_TEMP_BUCKET_PREFIX=tmp/document-intelligence
OCR_IMAGE_COPY_WIDTH_PERCENT=41
OCR_IMAGE_COPY_HEIGHT_PERCENT=29

OCR_PROVIDER=tesseract-cli
OCR_LANGUAGE=fra+eng
OCR_TIMEOUT_MS=60000
OCR_TEMP_DIR=/tmp/sigeda-ocr
