[Unit]
Description=SIGEDA preproduction healthcheck
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/sigeda/app/repo
ExecStart=/usr/bin/bash /opt/sigeda/app/repo/infra/docker/scripts/preprod-healthcheck.sh

[Install]
WantedBy=multi-user.target
